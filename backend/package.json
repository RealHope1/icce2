    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "cloudinary": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
